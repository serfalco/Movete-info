# Cabeceras de Cloudflare Workers (static assets) para movete.info.
# Las redirecciones (_redirects) se aplican antes que este archivo.

# Los afiches llevan por nombre una huella de su URL de origen: el mismo
# nombre es siempre la misma imagen, asi que el navegador puede guardarla un ano.
/assets/afiches/*
  Cache-Control: public, max-age=31536000, immutable

# max-image-preview:large deja que Google Discover (el feed del celular)
# muestre la tarjeta con imagen grande. Sin esto casi no muestra el sitio.
# No cambia la indexacion: un noindex de la pagina sigue mandando.
/*
  X-Robots-Tag: max-image-preview:large
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
